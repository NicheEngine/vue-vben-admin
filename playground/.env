# 高德地图 JS API Key（必填）
VITE_AMAP_SECRET_KEY=d9e19a41a86c6878bb34ca305d6b17e5
# 高德安全密钥（必填）
VITE_AMAP_SECURITY_CODE=7da8959a31429f928b3418df3ede1025
# 是否加载 AMapUI（可选，默认 false）
VITE_AMAP_UI_ENABLED=true
# 以下为可选配置
VITE_AMAP_API_VERSION=2.1Beta
VITE_AMAP_UI_VERSION=1.1
