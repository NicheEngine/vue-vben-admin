{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@vben/tsconfig/web.json",
  "include": [
    "src",
    "*.ts",
    "*.tsx",
    "*.vue",
    "*.d.ts",
    "src/*.ts",
    "src/*.tsx",
    "src/*.vue",
    "src/*.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "src/**/*.d.ts"
  ],
  "exclude": ["node_modules"]
}
